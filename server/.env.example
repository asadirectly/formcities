PORT=3000
DB_PATH=./data/app.db
SITES_DIR=../sites-storage
BASE_DOMAIN=localhost

SESSION_SECRET=replace-this-with-something-random

# where the formbar backend api lives
FORMBAR_API_URL=http://localhost:420
# where the formbar frontend (login page) lives
FORMBAR_CLIENT_URL=http://localhost:5173
# our own public url, formbar redirects back here after login
THIS_URL=http://localhost:3000
# our own frontend, where we send students after login succeeds
FRONTEND_URL=http://localhost:5174

# create this pool in formbar first (POST /api/v1/pools/create) then put its id here
PAY_POOL_ID=70
# how many digipogs it costs to publish/update a site
HOSTING_FEE=150
